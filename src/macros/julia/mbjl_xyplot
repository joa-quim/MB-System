# Purpose:
#   Julia port of src/macros/mbpy_xyplot, the Python/PyGMT-era
#   replacement for the Perl macro mbm_xyplot: reads one or more xy data
#   files and generates a GMT **modern mode** shellscript that plots
#   them, following the same page-layout and projection-fitting
#   conventions as mbm_xyplot itself (shared, in fact, with mbm_histplot's
#   own copies of the same subs -- see mbjl_xyplot_script.jl's top
#   comment). See src/macros/julia/mbjl_{layout,misc,xyplot_script}.jl
#   for the underlying logic.
#
#   Unlike mbm_xyplot's own single-letter "-M<sub>:<sub>:..." grammar for
#   coastline/text-label/length-scale tuning, this tool exposes each of
#   those as its own descriptive long option -- see the --help text.
#
#   Unlike mbm_xyplot itself, this tool never writes a persistent
#   temporary file: mbm_xyplot preprocesses every input file (delimiter-
#   splitting, per-file column-selection math) into a file named
#   "<input><n>.<pid>" left behind in the current directory after every
#   run. Here, the equivalent column-selection/math is done once in
#   memory (to find the auto-fit plot bounds) and, at plot time, through
#   a live `awk | gmt plot` pipe with nothing written to disk -- see
#   mbjl_xyplot_script.jl's top comment.
#
# Usage:
#   mbjl_xyplot -I data.xy -O plot [options...]
#   mbjl_xyplot --input "data.xy:symbol=c0.1:fill=red" --output plot \
#       --title "My Plot" --coast --coast-resolution i
#

# Locate the sibling mbjl_{util,layout,misc,xyplot_script} modules: they
# sit alongside this script once installed (flat bindir, matching how
# src/macros installs its Perl macros), and also alongside it in the
# source tree (src/macros/julia/) -- a julia/ subdirectory is tried too so
# a copy of this script placed one level up (as the Python tools are)
# still runs directly from a checkout without installing first.
let here = dirname(realpath(@__FILE__))
    for candidate in (here, joinpath(here, "julia"))
        if isfile(joinpath(candidate, "mbjl_xyplot_script.jl"))
            include(joinpath(candidate, "mbjl_xyplot_script.jl"))
            break
        end
    end
end

using .MbjlUtil
import .MbjlMisc
const misc = MbjlMisc
import .MbjlXyplotScript
const script = MbjlXyplotScript


function build_arg_parser()::ArgParser
    p = ArgParser(
        prog = "mbjl_xyplot",
        description = "Generate a GMT modern-mode plotting script for one or more xy data " *
                      "files (Julia port of the Python/PyGMT-era replacement for mbm_xyplot).",
    )

    g = add_argument_group(p, "input/output")
    add_argument!(g,
        "-I", "--input", action = :append, default = String[], required = true, metavar = "FILE[:key=val...]",
        help = "an xy data file to plot, with optional colon-separated overrides: " *
               "symbol=, fill=, pen= (styling, default from --symbol/--fill/--pen), " *
               "delimiter= (default: whitespace), xexpr=/yexpr= (column-selection/math " *
               "expressions, e.g. \"c[3]\", \"c[3]*2+1\" -- \"c[N]\" selects field N (1-indexed), " *
               "\"#\" is the input line number; default xexpr=c[1], yexpr=c[2]). Repeatable.",
    )
    add_argument!(g, "-O", "--output", metavar = "ROOT", help = "output root name [default: first --input file's basename without extension]")
    add_argument!(g, "--format", default = "pdf", metavar = "FMT", help = "output format: pdf, png, ps, jpg, tif, eps, ... [pdf]")
    add_argument!(g, "--title", metavar = "TEXT", help = "plot title")
    add_argument!(g, "--xlabel", default = " ", metavar = "TEXT", help = "x axis label (linear/Cartesian projections only)")
    add_argument!(g, "--ylabel", default = " ", metavar = "TEXT", help = "y axis label (linear/Cartesian projections only)")
    add_argument!(g, "--dpi", type = Int, metavar = "DPI", help = "final raster's resolution")
    add_argument!(g, "-X", "--execute", action = :store_true, help = "run the generated script immediately")
    add_argument!(g, "-V", "--verbose", action = :store_true, help = "print the generated script path and a brief summary")

    g = add_argument_group(p, "region / projection / page")
    add_argument!(g,
        "-R", "--region", metavar = "XMIN/XMAX/YMIN/YMAX[r]",
        help = "plot region [default: auto-computed from the data]; fields may be dd:mm:ss; " *
               "a trailing \"r\" means the four values are two corner points (SW, NE) rather " *
               "than a w/e/s/n range; a bare \"r\" reformats the auto-computed data bounds into " *
               "that corner-point form",
    )
    add_argument!(g, "-J", "--projection", metavar = "SPEC", help = "GMT map scale/projection spec, e.g. \"m1.0\", \"x0.02\", \"Xd6i\" [default: auto-fit linear]")
    add_argument!(g, "-P", "--pagesize", default = "a", metavar = "SIZE", help = "page size code (a, b, c, ... a4, ...) [a]")
    orient = add_mutually_exclusive_group(p)
    add_argument!(orient, "--portrait", action = :store_const, dest = :orientation, const_ = 1, help = "force portrait orientation")
    add_argument!(orient, "--landscape", action = :store_const, dest = :orientation, const_ = 2, help = "force landscape orientation")
    set_defaults!(p; orientation = 0)
    add_argument!(g, "-B", "--tick-info", metavar = "SPEC", help = "raw -B basemap tick spec override")
    add_argument!(g, "--length-scale", metavar = "SPEC", help = "GMT distance scale bar spec for -L on the basemap, e.g. \"fx10/2/32.70/5.0+lkm\"; the literal word " *
                                                              "\"center\" between two slashes is replaced with the plot's own data center")

    g = add_argument_group(p, "xy styling defaults (per-file overrides: see --input)")
    add_argument!(g, "-S", "--symbol", default = "N", metavar = "SYMBOL", help = "e.g. \"c0.1\" (GMT symbol code + size) [none: connect with a line]")
    add_argument!(g, "-G", "--fill", default = "N", metavar = "COLOR", help = "symbol/polygon fill color [none]")
    add_argument!(g, "-W", "--pen", default = "N", metavar = "PEN", help = "line pen, e.g. \"1p,black\" [none]")

    g = add_argument_group(p, "coastline")
    add_argument!(g, "--coast", action = :store_true, help = "enable a coastline overlay")
    add_argument!(g, "--coast-resolution", choices = ["f", "h", "i", "l", "c"], metavar = "{f,h,i,l,c}", help = "[f]")
    add_argument!(g, "--coast-dry-fill", metavar = "COLOR", help = "[200]")
    add_argument!(g, "--coast-wet-fill", metavar = "COLOR")
    add_argument!(g, "--coast-lake-fill", metavar = "COLOR")
    add_argument!(g, "--coast-river", metavar = "COLOR")
    add_argument!(g, "--coast-boundary", action = :append, default = String[], metavar = "SPEC", help = "national boundary spec (repeatable)")
    add_argument!(g, "--coast-pen", metavar = "PEN", help = "[1p]")

    g = add_argument_group(p, "text labels")
    add_argument!(g,
        "--text", action = :append, default = String[], metavar = "LON/LAT/SIZE/ANGLE/FONT/JUSTIFY/TEXT",
        help = "a text label to place, e.g. \"-122.2/36.6/12/0/1/LB/Monterey Bay\" (repeatable)",
    )

    g = add_argument_group(p, "GMT defaults")
    add_argument!(g, "--gmt-default", action = :append, default = String[], metavar = "PARAM/VALUE", help = "override a GMT default (repeatable)")

    return p
end


function parse_xy_file(spec::AbstractString, default_symbol::AbstractString, default_fill::AbstractString,
                       default_pen::AbstractString)::script.XYFileEntry
    parts = split(spec, ":")
    file = String(parts[1])
    symbol, fill, pen = String(default_symbol), String(default_fill), String(default_pen)
    delimiter = nothing
    xexpr, yexpr = "c[1]", "c[2]"
    for part in parts[2:end]
        i = findfirst('=', part)
        if i === nothing
            throw(ArgumentError("malformed --input style $(repr(String(part))) in $(repr(String(spec))) (expected key=value)"))
        end
        key, value = String(part[1:i-1]), String(part[i+1:end])
        if key == "symbol"
            symbol = value
        elseif key == "fill"
            fill = value
        elseif key == "pen"
            pen = value
        elseif key == "delimiter"
            delimiter = value
        elseif key == "xexpr"
            xexpr = value
        elseif key == "yexpr"
            yexpr = value
        else
            throw(ArgumentError("unknown --input style $(repr(key)) in $(repr(String(spec))) " *
                                "(expected symbol/fill/pen/delimiter/xexpr/yexpr)"))
        end
    end
    return script.XYFileEntry(file = file, xexpr = xexpr, yexpr = yexpr, delimiter = delimiter,
                              symbol = symbol, fill = fill, pen = pen)
end


_given(x) = x !== nothing && !(x isa AbstractString && isempty(x)) && !(x isa AbstractVector && isempty(x))


function main(argv = ARGS)::Int
    args = parse_args(build_arg_parser(), argv)

    entries = [parse_xy_file(spec, args[:symbol], args[:fill], args[:pen]) for spec in args[:input]]
    if isempty(entries)
        print(stderr, "\a\nNo input file specified!\nmbjl_xyplot aborted\n\n")
        return 1
    end
    for entry in entries
        if !isfile(entry.file)
            print(stderr, "\a\nInput file $(entry.file) cannot be opened!\nmbjl_xyplot aborted\n\n")
            return 1
        end
    end

    root = _given(args[:output]) ? args[:output] : replace(basename(entries[1].file), r"\.[A-Za-z0-9]+$" => "")

    # BUG FIX (present in mbpy_xyplot, not in mbm_xyplot): the Python tool
    # skipped the data scan for ANY --region, including the bare "r" form,
    # whose whole meaning is "reformat the auto-computed data bounds into
    # corner-point form" (see MbjlXyplotScript._resolve_bounds()). With the
    # scan skipped those bounds were all 0.0, so "-R r" always produced the
    # padded dummy region "-1/-1/1/1r" instead of the data's own extent.
    # mbm_xyplot itself always reads the data before handling -R.
    if _given(args[:region]) && args[:region] != "r"
        data_xmin = data_xmax = data_ymin = data_ymax = 0.0
    else
        data_xmin, data_xmax, data_ymin, data_ymax = script.scan_xy_bounds(entries)
    end

    length_scale = args[:length_scale]
    if _given(length_scale)
        # Port of mbm_xyplot lines ~1087-1096: substitute the literal word
        # "center" for the plot's own data center, so e.g.
        # "-MGLfx122.2center32.70/5.0+lkm" becomes a real -L spec.
        m = match(r"^(\S+)center(\S+)$", length_scale)
        if m !== nothing
            xmin_r, xmax_r, ymin_r, ymax_r, _ = script._resolve_bounds(
                data_xmin, data_xmax, data_ymin, data_ymax, args[:region]
            )
            xcen, ycen = 0.5 * (xmin_r + xmax_r), 0.5 * (ymin_r + ymax_r)
            length_scale = "$(m.captures[1])$(fmtg(xcen, 8))/$(fmtg(ycen, 8))$(m.captures[2])"
        end
    end

    coast = nothing
    if args[:coast] || _given(args[:coast_resolution]) || _given(args[:coast_dry_fill]) || _given(args[:coast_wet_fill]) ||
            _given(args[:coast_lake_fill]) || _given(args[:coast_river]) || _given(args[:coast_boundary]) || _given(args[:coast_pen])
        # Port of mbm_xyplot lines ~1071-1085: these two defaults are
        # specific to mbm_xyplot's own coastline handling -- confirmed
        # via direct diff that mbm_grdplot's coastline setup has no
        # equivalent fallback at all.
        coast_dryfill = args[:coast_dry_fill]
        coast_pen = args[:coast_pen]
        if !(_given(coast_dryfill) || _given(args[:coast_wet_fill]) || _given(coast_pen) ||
             _given(args[:coast_boundary]) || _given(args[:coast_river]))
            coast_dryfill = _given(coast_dryfill) ? coast_dryfill : "200"
            coast_pen = _given(coast_pen) ? coast_pen : "1p"
        end
        coast_resolution = _given(args[:coast_resolution]) ? args[:coast_resolution] : "f"
        coast = misc.CoastOptions(
            coast_control = true,
            coast_resolution = coast_resolution,
            coast_dryfill = coast_dryfill,
            coast_wetfill = args[:coast_wet_fill],
            coast_lakefill = args[:coast_lake_fill],
            coast_river = args[:coast_river],
            coast_boundaries = collect(String, args[:coast_boundary]),
            coast_pen = coast_pen,
        )
    end

    lay = script.compute_layout_xy(
        data_xmin, data_xmax, data_ymin, data_ymax;
        pagesize = args[:pagesize], map_scale = args[:projection], orientation = args[:orientation],
        region = args[:region], tick_info = args[:tick_info], xlabel = args[:xlabel], ylabel = args[:ylabel],
    )

    opts = script.ScriptOptionsXY(
        entries = entries, root = root, layout = lay, output_format = args[:format],
        title = args[:title], dpi = args[:dpi], length_scale = length_scale, coast = coast,
        text_labels = collect(String, args[:text]), gmt_defs = collect(String, args[:gmt_default]),
    )

    script_path = "$(root).sh"
    script.generate_and_write_xy(opts, script_path)

    if args[:verbose]
        println("Generated $(script_path) (output: $(root).$(args[:format]))")
    end

    if args[:execute]
        run(`bash $script_path`)
    end

    return 0
end


if abspath(PROGRAM_FILE) == @__FILE__
    exit(main())
end
