# Purpose:
#   Julia port of src/macros/mbpy_grd3dplot, the Python/PyGMT-era
#   replacement for the Perl macro mbm_grd3dplot: reads
#   a grid and generates a GMT **modern mode** shellscript that plots a
#   3D perspective view of it (via `gmt grdview`), following the same
#   page-layout, projection-fitting, and color-palette conventions as
#   mbm_grd3dplot itself. See src/macros/julia/mbjl_{layout,color,misc,
#   grd3dplot_script}.jl for the underlying port of that logic; layout/
#   color/misc are shared with mbjl_grdplot and mbjl_histplot.
#
#   Unlike mbm_grd3dplot's single-letter "-M<sub>:<sub>:..." grammar for
#   coastline/grdview tuning, this tool exposes each of those as its own
#   descriptive long option -- see the --help text.
#
# Usage:
#   mbjl_grd3dplot -I data.grd -O plot [options...]
#   mbjl_grd3dplot --input data.grd --output plot --title "My Plot" \
#       --color-mode 2 --view 150/15 --exaggeration 2
#

# Locate the sibling mbjl_{util,layout,color,misc,grdplot_script,
# grd3dplot_script} modules: they sit alongside this script once
# installed (flat bindir, matching how src/macros installs its Perl
# macros), or one level down in a julia/ subdirectory -- try both so
# this also runs directly from a checkout without installing first.
let here = dirname(realpath(@__FILE__))
    for candidate in (here, joinpath(here, "julia"))
        if isfile(joinpath(candidate, "mbjl_grd3dplot_script.jl"))
            include(joinpath(candidate, "mbjl_grd3dplot_script.jl"))
            break
        end
    end
end

using .MbjlUtil
const layout = MbjlLayout
const color = MbjlColor
const misc = MbjlMisc
const script = MbjlGrd3dplotScript


function build_arg_parser()::ArgParser
    p = ArgParser(
        prog = "mbjl_grd3dplot",
        description = "Generate a GMT modern-mode 3D perspective plotting script for a grid " *
                      "(Julia port of the Python/PyGMT-era replacement for mbm_grd3dplot).",
    )

    g = add_argument_group(p, "input/output")
    add_argument!(g, "-I", "--input", required = true, metavar = "GRID", help = "input grid file")
    add_argument!(g, "-O", "--output", metavar = "ROOT", help = "output root name [default: input's basename without extension]")
    add_argument!(g, "--format", default = "pdf", metavar = "FMT", help = "output format: pdf, png, ps, jpg, tif, eps, ... [pdf]")
    add_argument!(g, "--title", metavar = "TEXT", help = "plot title")
    add_argument!(g, "--colorbar-label", metavar = "TEXT", help = "color scale bar label [z]")
    add_argument!(g, "--dpi", type = Int, metavar = "DPI", help = "rendering resolution: grdview's own -Qi<dpi>, and the final raster's resolution")
    add_argument!(g, "-X", "--execute", action = :store_true, help = "run the generated script immediately")
    add_argument!(g, "-V", "--verbose", action = :store_true, help = "print the generated script path and a brief summary")

    g = add_argument_group(p, "region / projection / page")
    add_argument!(g, "-R", "--region", metavar = "XMIN/XMAX/YMIN/YMAX", help = "plot region [default: the grid's own bounds]")
    add_argument!(g, "-J", "--projection", metavar = "SPEC", help = "GMT map scale/projection spec, e.g. \"m1.0\", \"x0.02\" [default: auto-fit Mercator or linear]")
    add_argument!(g, "-P", "--pagesize", default = "a", metavar = "SIZE", help = "page size code (a, b, c, ... a4, ...) [a]")
    orient = add_mutually_exclusive_group(p)
    add_argument!(orient, "--portrait", action = :store_const, dest = "orientation", const_ = 1, help = "force portrait orientation")
    add_argument!(orient, "--landscape", action = :store_const, dest = "orientation", const_ = 2, help = "force landscape orientation")
    add_argument!(g, "--scale-location", default = "b", choices = ["l", "r", "t", "b"], help = "color scale bar placement [b]")
    add_argument!(g, "--tick-info", metavar = "SPEC", help = "raw -B basemap tick spec override (x/y/z combined)")
    add_argument!(g, "--length-scale", metavar = "SPEC", help = "GMT distance scale bar spec for -L on the basemap (mbm_grd3dplot's -MGL)")

    g = add_argument_group(p, "3D view")
    add_argument!(g, "-E", "--view", default = "240/30", metavar = "AZIMUTH/ELEVATION", help = "viewpoint azimuth/elevation, e.g. \"150/15\" [240/30]")
    add_argument!(g, "-F", "--exaggeration", type = Float64, metavar = "FACTOR", help = "vertical exaggeration [default: chosen from --zscale, or 2.0/(zmax-zmin) if neither given]")
    add_argument!(g, "--zscale", type = Float64, dest = "zscale", metavar = "VAL", help = "explicit map z-scale (-Jz<val>), overriding --exaggeration")

    g = add_argument_group(p, "color")
    add_argument!(g, "--color-mode", type = Int, default = 1, choices = 1:7, metavar = "{1-7}",
                  help = "1 color fill, 2 shaded relief, 3 shade by intensity file, 4 slope-magnitude fill, " *
                         "5 shade by slope magnitude, 6 mesh plot, 7 mesh plot with contours [1]")
    add_argument!(g, "-W", "--color-control", metavar = "SPEC", help = "\"style/palette/ncolors\" (e.g. \"1/2/11\"), or a path to an existing .cpt file")
    add_argument!(g, "-D", "--color-flip", action = :store_true, help = "reverse the color palette")
    add_argument!(g, "-Y", "--no-nice-interval", action = :store_true, help = "use a direct linear color stretch instead of rounded intervals")
    add_argument!(g, "--stretch-color", action = :store_true, help = "histogram-equalize the color stretch (color_mode 1)")
    add_argument!(g, "-Z", "--zbounds", metavar = "ZMIN/ZMAX", help = "override the grid's own z-range used for the color stretch")
    add_argument!(g, "--data-scale", type = Float64, metavar = "FACTOR", help = "rescale grid values before colorizing/shading")

    g = add_argument_group(p, "shading (color_mode 2/3/4/5)")
    add_argument!(g, "--magnitude", type = Float64, metavar = "VAL")
    add_argument!(g, "--azimuth", type = Float64, metavar = "DEG")
    add_argument!(g, "--elevation", type = Float64, metavar = "DEG")
    add_argument!(g, "--shade-flip", action = :store_true, help = "reverse the shading direction (negates magnitude)")
    add_argument!(g, "--intensity-file", metavar = "GRID", help = "intensity grid for color_mode 3")
    add_argument!(g, "--stretch-shade", action = :store_true, help = "histogram-equalize the intensity file (color_mode 3)")

    g = add_argument_group(p, "mesh (color_mode 6/7)")
    add_argument!(g, "--mesh-contour-pen", metavar = "PEN", help = "contour-line pen drawn on the mesh (color_mode 7 only; mbm_grd3dplot's -MVW)")

    g = add_argument_group(p, "grdview")
    add_argument!(g, "--drape-file", metavar = "GRID", help = "grid to drape on the relief instead of coloring it directly (mbm_grd3dplot's -N)")
    add_argument!(g, "--mesh-null", nargs = "?", const_ = true, default = false, metavar = "LEVEL/R/G/B",
                  help = "null-plane level/color for undefined nodes (mbm_grd3dplot's -MVN) " *
                         "[default level: \"<zmin>/200/200/200\" if given with no value]")
    add_argument!(g, "--mesh-zlevel", metavar = "VAL", help = "z level for the base plane/frame (mbm_grd3dplot's -MVZ)")

    g = add_argument_group(p, "coastline")
    add_argument!(g, "--coast", action = :store_true, help = "enable a coastline overlay")
    add_argument!(g, "--coast-resolution", choices = ["f", "h", "i", "l", "c"], metavar = "{f,h,i,l,c}")
    add_argument!(g, "--coast-dry-fill", metavar = "COLOR")
    add_argument!(g, "--coast-wet-fill", metavar = "COLOR")
    add_argument!(g, "--coast-lake-fill", metavar = "COLOR")
    add_argument!(g, "--coast-river", metavar = "COLOR")
    add_argument!(g, "--coast-boundary", action = :append, default = String[], metavar = "SPEC", help = "national boundary spec (repeatable)")
    add_argument!(g, "--coast-pen", metavar = "PEN")

    g = add_argument_group(p, "text labels")
    add_argument!(g,
        "--text", action = :append, default = String[], metavar = "LON/LAT/SIZE/ANGLE/FONT/JUSTIFY/TEXT",
        help = "a text label to place, e.g. \"-122.2/36.6/12/0/1/LB/Monterey Bay\" (repeatable)",
    )

    g = add_argument_group(p, "GMT defaults")
    add_argument!(g, "--gmt-default", action = :append, default = String[], metavar = "PARAM/VALUE", help = "override a GMT default (repeatable)")

    return p
end


_nonempty(s) = s !== nothing && !isempty(s)


"""Resolve --color-control/--stretch-color/etc into either
(cpt_lines, nothing) or (nothing, cpt_file). Mirrors mbjl_grdplot's own
build_cpt() (same underlying color-mode/palette math, ported once
in mbjl_color.jl and shared by both CLIs)."""
function build_cpt(args, grid_info::layout.GridInfo, contour_int::Real)
    cc = color.resolve_color_control(args[:color_control])
    if cc.file_cpt !== nothing
        return nothing, cc.file_cpt
    end

    dzz = grid_info.zmax - grid_info.zmin
    ncolors_use = color.get_ncolors_use(cc.ncolors, cc.color_style)
    is_sealevel = cc.color_palette in color.SEALEVEL_PALETTES
    flip = args[:color_flip]

    if args[:color_mode] == 4
        magnitude = args[:magnitude] !== nothing ? args[:magnitude] : 1.0
        boundaries = color.build_slope_boundaries(magnitude, ncolors_use, cc.color_style)
        colors = color.interpolate_palette(cc.color_palette, ncolors_use)
        if cc.color_style == 1
            return color.build_cpt_continuous_from_boundaries(colors, boundaries; color_flip = flip), nothing
        end
        return color.build_cpt_discrete_from_boundaries(colors, cc.ncolors, boundaries; color_flip = flip), nothing
    end

    if args[:stretch_color]
        rows = color.run_grdhisteq(args[:input], cc.ncolors)
        hb = color.build_histogram_boundaries(
            rows, cc.ncolors, grid_info.zmin, grid_info.zmax, dzz; color_style = cc.color_style
        )
        nsamples = cc.color_style == 1 ? hb.ncolors : hb.ncolors + 1
        colors = color.interpolate_palette(cc.color_palette, nsamples)
        if cc.color_style == 1
            return color.build_cpt_continuous_from_boundaries(colors, hb.hist; color_flip = flip), nothing
        end
        return color.build_cpt_discrete_from_boundaries(colors, hb.ncolors, hb.hist; color_flip = flip), nothing
    end

    interval = color.compute_color_interval(
        dzz, grid_info.zmin, grid_info.zmax, ncolors_use, contour_int, args[:no_nice_interval]
    )
    if is_sealevel
        izero = color.compute_sealevel_izero(
            ncolors_use, interval.color_int, interval.color_start, interval.color_end, flip
        )
        cptub, cptue = color.interpolate_palette_sealevel(cc.color_palette, ncolors_use, izero)
        if cc.color_style == 1
            cpt_lines = color.build_cpt_continuous_sealevel(cptub, cptue, interval.color_start, interval.color_int; color_flip = flip)
        else
            cpt_lines = color.build_cpt_discrete_sealevel(cptub, cptue, cc.ncolors, interval.color_start, interval.color_int; color_flip = flip)
        end
    else
        colors = color.interpolate_palette(cc.color_palette, ncolors_use)
        if cc.color_style == 1
            cpt_lines = color.build_cpt_continuous(colors, interval.color_start, interval.color_int; color_flip = flip)
        else
            cpt_lines = color.build_cpt_discrete(colors, cc.ncolors, interval.color_start, interval.color_int; color_flip = flip)
        end
    end
    return cpt_lines, nothing
end


function main(argv = ARGS)::Int
    args = parse_args(build_arg_parser(), argv)

    root = _nonempty(args[:output]) ? args[:output] : replace(basename(args[:input]), r"\.[A-Za-z0-9]+$" => "")

    grid_info = layout.run_grdinfo(args[:input])
    if _nonempty(args[:zbounds])
        zmin_s, zmax_s = split(args[:zbounds], "/")
        grid_info = pyreplace(grid_info; zmin = pyfloat(zmin_s), zmax = pyfloat(zmax_s))
    end

    lay = script.compute_layout_3d(
        grid_info; view_control = args[:view], pagesize = args[:pagesize], scale_loc = args[:scale_location],
        map_scale = args[:projection], orientation = something(args[:orientation], 0), region = args[:region],
        exaggeration = args[:exaggeration], map_zscale = args[:zscale],
    )
    # compute_layout_3d() may have resolved gridprojected differently
    # than run_grdinfo() alone did (see MbjlLayout.compute_layout()'s
    # docstring on the out-of-bounds fallback); propagate that back so
    # the shading commands below (which read grid_info.gridprojected to
    # decide grdgradient's -fg flag) agree with it.
    if lay.gridprojected != grid_info.gridprojected
        grid_info = pyreplace(grid_info; gridprojected = lay.gridprojected)
    end

    mesh = args[:color_mode] in (6, 7)
    cc = color.resolve_color_control(args[:color_control])
    color_palette = cc.color_palette
    cpt_lines, cpt_file = build_cpt(args, grid_info, lay.contour_int)

    # Mesh modes (6/7) never take grdview shading/intensity (-I) --
    # only color_mode 2-5 do (mbm_grd3dplot lines ~2001-2008).
    shade = nothing
    if !mesh && args[:color_mode] != 1
        shade = script.ShadeOptions(
            color_mode = args[:color_mode],
            magnitude = args[:magnitude], azimuth = args[:azimuth], elevation = args[:elevation],
            shade_flip = args[:shade_flip],
            file_intensity = args[:intensity_file], stretch_shade = args[:stretch_shade],
        )
    end

    mesh_null = nothing
    if args[:mesh_null] === true
        mesh_null = "$(fmtg(grid_info.zmin, 10))/200/200/200"
    elseif args[:mesh_null] isa AbstractString
        mesh_null = args[:mesh_null]
    end

    coast = nothing
    if args[:coast] || _nonempty(args[:coast_resolution]) || _nonempty(args[:coast_dry_fill]) ||
            _nonempty(args[:coast_wet_fill]) || _nonempty(args[:coast_lake_fill]) ||
            _nonempty(args[:coast_river]) || !isempty(args[:coast_boundary]) || _nonempty(args[:coast_pen])
        coast = misc.CoastOptions(
            coast_control = true,
            coast_resolution = args[:coast_resolution],
            coast_dryfill = args[:coast_dry_fill],
            coast_wetfill = args[:coast_wet_fill],
            coast_lakefill = args[:coast_lake_fill],
            coast_river = args[:coast_river],
            coast_boundaries = collect(String, args[:coast_boundary]),
            coast_pen = args[:coast_pen],
        )
    end

    opts = script.ScriptOptions3D(
        grid = args[:input], root = root, layout = lay, grid_info = grid_info,
        output_format = args[:format], title = args[:title], tick_info = args[:tick_info],
        colorbar_label = args[:colorbar_label], length_scale = args[:length_scale], dpi = args[:dpi],
        shade = shade, mesh = mesh, mesh_contour_pen = args[:mesh_contour_pen],
        color_palette = color_palette, color_flip = args[:color_flip],
        data_scale = args[:data_scale], cpt_lines = cpt_lines, cpt_file = cpt_file,
        drape_file = args[:drape_file], mesh_null = mesh_null, mesh_zlevel = args[:mesh_zlevel],
        coast = coast, text_labels = collect(String, args[:text]),
        gmt_defs = collect(String, args[:gmt_default]),
    )

    script_path = "$(root).sh"
    script.generate_and_write_3d(opts, script_path)

    if args[:verbose]
        println("Generated $(script_path) (output: $(root).$(args[:format]))")
    end

    if args[:execute]
        run(`bash $script_path`)
    end

    return 0
end


if abspath(PROGRAM_FILE) == @__FILE__
    exit(main())
end
